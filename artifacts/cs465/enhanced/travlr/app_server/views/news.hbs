<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>

<body>
    <div id="background">
        <div id="page">

            {{> header}}
            {{> nav}}

            <div id="contents">
                <h1>{{title}}</h1>

                {{#each news}}
                    <h2>{{title}}</h2>

                    <p><strong>Date:</strong> {{date}}</p>
                    <p><strong>Author:</strong> {{author}}</p>

                    <p>{{summary}}</p>

                    <hr>
                {{/each}}
            </div>

            {{> footer}}

        </div>
    </div>
</body>
</html>
