<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>

<body>
    <div id="background">
        <div id="page">

            {{> header}}
            {{> nav}}

            <div id="contents">
                <h1>{{meal.name}}</h1>

                <ul id="sites">
                    <li>
                        <img src="/images/{{meal.image}}" alt="{{meal.name}} image" width="260" height="180">
                        <h2>{{meal.name}}</h2>
                        <p><strong>Code:</strong> {{meal.code}}</p>
                        <p><strong>Type:</strong> {{meal.type}}</p>
                        <p><strong>Price:</strong> ${{meal.price}}</p>
                        <p>{{meal.description}}</p>
                        <p class="travel-actions">
                            <a class="action-link" href="/meals/json/{{meal.code}}">View JSON</a>
                            <a class="action-link" href="/meals">Back to Meals</a>
                        </p>
                    </li>
                </ul>
            </div>

            {{> footer}}

        </div>
    </div>
</body>
</html>
