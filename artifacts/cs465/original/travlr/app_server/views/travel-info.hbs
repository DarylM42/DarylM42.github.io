<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>

<body>
    <div id="background">
        <div id="page">

            {{> header}}
            {{> nav}}

            <div id="contents">
                <h1>{{trip.name}}</h1>

                <ul id="sites">
                    <li>
                        <img src="/images/dive-site.png" alt="{{trip.name}} image" width="260" height="180">
                        <h2>{{trip.name}}</h2>
                        <p><strong>Code:</strong> {{trip.code}}</p>
                        <p><strong>Length:</strong> {{trip.length}} days</p>
                        <p><strong>Start Date:</strong> {{trip.start}}</p>
                        <p><strong>Price:</strong> ${{trip.price}}</p>
                        <p>{{trip.description}}</p>
                        <p class="travel-actions">
                            <a class="action-link" href="/api/trips/{{trip.code}}">View API JSON</a>
                            <a class="action-link" href="/travel">Back to Travel List</a>
                        </p>
                    </li>
                </ul>
            </div>

            {{> footer}}

        </div>
    </div>
</body>
</html>
