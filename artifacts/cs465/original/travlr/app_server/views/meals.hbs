<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>

<body>
    <div id="background">
        <div id="page">

            {{> header}}
            {{> nav}}

            <div id="contents">
                <h1>{{title}}</h1>

                {{#each meals}}
                    <h2>{{name}}</h2>

                    <p><strong>Code:</strong> {{code}}</p>
                    <p><strong>Type:</strong> {{type}}</p>
                    <p><strong>Price:</strong> ${{price}}</p>

                    <p>{{description}}</p>

                    <hr>
                {{/each}}
            </div>

            {{> footer}}

        </div>
    </div>
</body>
</html>
